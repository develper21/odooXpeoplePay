# ==============================================================================
# PEOPLEPAY360 - FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================

# Data Mode:
# 'api'  -> Connects to the real backend server (Production / Live)
# 'mock' -> Uses built-in frontend mock data (Local offline preview)
NEXT_PUBLIC_DATA_MODE=api

# ------------------------------------------------------------------------------
# API CONNECTION (Choose Option 1 or Option 2)
# ------------------------------------------------------------------------------

# Option 1 (RECOMMENDED for Vercel deployment):
# Keep NEXT_PUBLIC_API_BASE_URL as /api (all calls stay on the same domain).
# Next.js rewrites on Vercel automatically forward /api/* calls to Render.
# This eliminates ALL cross-site cookie and CORS issues!
NEXT_PUBLIC_API_BASE_URL=/api
BACKEND_PROXY_URL=https://your-backend-service.onrender.com/api

# Option 2 (Direct Cross-Origin API Calls):
# If you want browser to call Render directly:
# NEXT_PUBLIC_API_BASE_URL=https://your-backend-service.onrender.com/api

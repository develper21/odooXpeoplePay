# ==============================================================================
# PEOPLEPAY360 - UNIFIED ENVIRONMENT VARIABLES (Next.js Full-Stack)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Data Mode:
# 'api'  -> Connects to the real database API routes (Production / Live)
# 'mock' -> Uses built-in frontend mock data (Local offline preview)
NEXT_PUBLIC_DATA_MODE=api

# API Base URL:
# Set to '/api' for same-origin serverless API routes on Vercel or local dev.
NEXT_PUBLIC_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Drizzle ORM)
# ------------------------------------------------------------------------------
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/odoopeoplepay
#
# Production Serverless PostgreSQL (Neon.tech / Supabase / Render Postgres):
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/odoopeoplepay?sslmode=require

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT + Cookies)
# ------------------------------------------------------------------------------
# JWT Secret for Authentication (Minimum 32 random characters in production)
JWT_SECRET=peoplepay360-super-secret-jwt-key-min-32-chars-2026

# JWT Token Expiry (e.g. 7d, 24h, 30m - default: 7d)
JWT_EXPIRES_IN=7d

# Cookie SameSite attribute ('lax' recommended for same-origin Vercel deployment)
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (Optional - for emailing payslips via SMTP)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="PeoplePay360 HR <noreply@peoplepay360.com>"
